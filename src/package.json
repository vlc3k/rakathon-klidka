{
  "name": "rakathon-pitstart",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:reading": "tsx --tsconfig tsconfig.json --test lib/reading/*.test.ts lib/*.test.ts",
    "dev:https": "next dev --experimental-https -H 0.0.0.0 -p 3006",
    "seed:fhir": "node scripts/seed-fhir.mjs",
    "fhir:vysledek": "node scripts/fhir-vysledek.mjs",
    "seed:patients": "tsx --tsconfig tsconfig.json scripts/seed-patients.ts",
    "seed:cases": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/seed-cases.ts",
    "test": "vitest run && npm run test:reading",
    "test:api": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --tsconfig tsconfig.json scripts/seed.ts",
    "staff:create": "tsx --tsconfig tsconfig.json scripts/create-staff-user.ts",
    "smoke": "tsx --tsconfig tsconfig.json scripts/smoke-test.ts"
  },
  "dependencies": {
    "@azure/identity": "^4.13.3",
    "@azure/storage-blob": "^12.34.0",
    "@base-ui/react": "^1.9.0",
    "@mediapipe/tasks-vision": "1.0.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.58.0",
    "motion": "^14.3.0",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "scanic": "^1.7.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.22.0",
    "sharp": "^0.35.5",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "braces": "file:./vendor/braces"
  }
}
